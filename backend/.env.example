# ============================================================
# HireSwift ATS - Environment & SMTP Configuration
# ============================================================
#
# NOTE FOR HACKATHON EVALUATION:
# Live SMTP is 100% OPTIONAL. HireSwift runs out-of-the-box in
# "Fast Simulated Mode" with complete personalized variable rendering
# and timestamped audit logging.
#
# If you want to dispatch REAL emails to actual inboxes (e.g., your own Gmail),
# rename this file to `.env` and fill in the 4 fields below:

# 1. SMTP Server Host (for Gmail: smtp.gmail.com, for Outlook: smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# 2. SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# 3. Your Email Address
SMTP_USER=your_email@gmail.com

# 4. Your 16-character Google App Password (NOT your normal Gmail password!)
# To generate one: Go to Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASSWORD=abcd efgh ijkl mnop

# 5. Optional Sender Display Email
SMTP_FROM_EMAIL=your_email@gmail.com

# 6. Enable TLS (true for port 587)
SMTP_USE_TLS=true
